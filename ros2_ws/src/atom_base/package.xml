<?xml version="1.0"?>
<package format="3">
  <name>atom_base</name><version>0.1.0</version>
  <description>Jazzy navigation, fine positioning and exclusive velocity boundary adapted from LabBot handover.</description>
  <maintainer email="project-atom@unimelb.edu.au">Project ATOM</maintainer>
  <license>Apache-2.0</license><license>MIT</license><license>BSD-3-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend><exec_depend>action_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend><exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend><exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend><exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>nav2_bringup</exec_depend>
  <exec_depend>robot_localization</exec_depend><exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>atom_mobile_description</exec_depend><exec_depend>atom_gripper_hardware</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
