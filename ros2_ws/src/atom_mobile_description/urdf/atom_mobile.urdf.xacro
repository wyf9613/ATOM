<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="ATOM_MOBILE_UF850">
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="base_top_height" default="0.15"/>
  <xacro:arg name="pedestal_height" default="0.805"/>
  <xacro:arg name="pedestal_width" default="0.36"/>
  <xacro:arg name="pedestal_depth" default="0.32"/>
  <!-- Neutral review orientation only; user explicitly left yaw unconfirmed. -->
  <xacro:arg name="arm_mount_yaw" default="0.0"/>
  <xacro:arg name="gripper_mount_xyz" default="0 0 0"/>
  <xacro:arg name="gripper_mount_rpy" default="0 0 0"/>
  <xacro:include filename="$(find atom_mobile_description)/urdf/tracer_review.urdf.xacro"/>
  <xacro:include filename="$(find atom_mobile_description)/urdf/pedestal.urdf.xacro"/>
  <xacro:include filename="$(find xarm_description)/urdf/xarm_device_macro.xacro"/>
  <xacro:include filename="$(find atom_gripper_description)/urdf/atom_gripper_v2.urdf.xacro"/>
  <xacro:atom_tracer_review top_height="$(arg base_top_height)"/>
  <xacro:atom_pedestal height="$(arg pedestal_height)" width="$(arg pedestal_width)" depth="$(arg pedestal_depth)"/>
  <xacro:xarm_device prefix="$(arg prefix)" hw_ns="ufactory" limited="true"
    dof="6" robot_type="uf850" ros2_control_plugin="fake_components/GenericSystem"
    add_gripper="false" add_vacuum_gripper="false" add_bio_gripper="false"
    attach_to="arm_mount" attach_xyz="0 0 0" attach_rpy="0 0 $(arg arm_mount_yaw)"
    create_attach_link="false" load_gazebo_plugin="false"/>
  <xacro:atom_gripper_v2 parent="$(arg prefix)link_eef" prefix="$(arg prefix)">
    <origin xyz="$(arg gripper_mount_xyz)" rpy="$(arg gripper_mount_rpy)"/>
  </xacro:atom_gripper_v2>
</robot>
