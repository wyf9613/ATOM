<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Nominal CAD review only; inertial and camera calibration are unmeasured. -->
  <xacro:macro name="atom_mount_v2" params="parent gripper_base prefix:=''">
    <link name="${prefix}flange_adapter">
      <visual><origin xyz="-0.043494000 -0.022225000 0.080800000" rpy="1.5707963267948966 1.5707963267948966 0"/>
        <geometry><mesh filename="package://atom_gripper_description/meshes/generated/mount/flange_adapter.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="atom_mount"><color rgba="0.25 0.45 0.65 1"/></material></visual>
      <collision><origin xyz="0.000000000 -0.000000000 0.025000000"/><geometry><box size="0.085000000 0.113000000 0.055000000"/></geometry></collision>
    </link>
    <joint name="${prefix}flange_adapter_joint" type="fixed"><parent link="${parent}"/><child link="${prefix}flange_adapter"/></joint>
    <link name="${prefix}esp32_bracket">
      <visual><origin xyz="-0.043494000 -0.022225000 0.028836000" rpy="1.5707963267948966 1.5707963267948966 0"/>
        <geometry><mesh filename="package://atom_gripper_description/meshes/generated/mount/esp32_bracket.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="atom_mount"><color rgba="0.25 0.45 0.65 1"/></material></visual>
      <collision><origin xyz="0.000000000 0.048550000 0.073536000"/><geometry><box size="0.043000000 0.018900000 0.068000000"/></geometry></collision>
    </link>
    <joint name="${prefix}esp32_bracket_joint" type="fixed"><parent link="${gripper_base}"/><child link="${prefix}esp32_bracket"/></joint>
    <link name="${prefix}camera_bracket">
      <visual><origin xyz="-0.043494000 -0.022225000 0.028836000" rpy="1.5707963267948966 1.5707963267948966 0"/>
        <geometry><mesh filename="package://atom_gripper_description/meshes/generated/mount/camera_bracket.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="atom_mount"><color rgba="0.25 0.45 0.65 1"/></material></visual>
      <collision><origin xyz="0.000000000 -0.064049999 0.062536000"/><geometry><box size="0.066000000 0.049900002 0.046000000"/></geometry></collision>
    </link>
    <joint name="${prefix}camera_bracket_joint" type="fixed"><parent link="${gripper_base}"/><child link="${prefix}camera_bracket"/></joint>
    <!-- Nominal D435i housing; USB/cables/optical TF and inertial data absent. -->
    <link name="${prefix}d435i_body">
      <visual><geometry><box size="0.090000000 0.025000000 0.025050000"/></geometry>
        <material name="atom_camera"><color rgba="0.55 0.57 0.60 1"/></material></visual>
      <collision><origin xyz="0 0 0"/><geometry><box size="0.091000000 0.026000000 0.026050000"/></geometry></collision>
    </link>
    <joint name="${prefix}d435i_body_joint" type="fixed"><parent link="${gripper_base}"/><child link="${prefix}d435i_body"/><origin xyz="0.000000000 -0.073000000 0.097561000" rpy="0 0 0"/></joint>
  </xacro:macro>
</robot>
