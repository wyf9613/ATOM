<?xml version="1.0"?>
<sdf version="1.9">
  <world name="atom_grasp">
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>4 4</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>4 4</size></plane></geometry>
          <material><ambient>0.55 0.57 0.58 1</ambient><diffuse>0.65 0.67 0.68 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A scenario fixture, not a model of either laboratory instrument. -->
    <model name="cuvette_support">
      <static>true</static>
      <pose>0.2982 0.13235 0 0 0 0</pose>
      <link name="support">
        <collision name="pedestal_collision">
          <pose>0 0 0.0525 0 0 0</pose>
          <geometry><box><size>0.030 0.030 0.105</size></box></geometry>
          <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface>
        </collision>
        <collision name="tray_collision">
          <pose>0 0 0.110 0 0 0</pose>
          <geometry><box><size>0.025 0.025 0.010</size></box></geometry>
          <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface>
        </collision>
        <visual name="pedestal_visual">
          <pose>0 0 0.0525 0 0 0</pose>
          <geometry><box><size>0.030 0.030 0.105</size></box></geometry>
          <material><ambient>0.18 0.22 0.24 1</ambient><diffuse>0.28 0.32 0.34 1</diffuse></material>
        </visual>
        <visual name="tray_visual">
          <pose>0 0 0.110 0 0 0</pose>
          <geometry><box><size>0.025 0.025 0.010</size></box></geometry>
          <material><ambient>0.18 0.22 0.24 1</ambient><diffuse>0.28 0.32 0.34 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Target fixture for the 0.2 rad shoulder-pan transfer test. -->
    <model name="cuvette_target_support">
      <static>true</static>
      <pose>0.2660 0.1890 0 0 0 0</pose>
      <link name="support">
        <collision name="pedestal_collision">
          <pose>0 0 0.0525 0 0 0</pose>
          <geometry><box><size>0.030 0.030 0.105</size></box></geometry>
        </collision>
        <collision name="tray_collision">
          <pose>0 0 0.110 0 0 0</pose>
          <geometry><box><size>0.025 0.025 0.010</size></box></geometry>
        </collision>
        <visual name="pedestal_visual">
          <pose>0 0 0.0525 0 0 0</pose>
          <geometry><box><size>0.030 0.030 0.105</size></box></geometry>
          <material><ambient>0.22 0.24 0.18 1</ambient><diffuse>0.36 0.38 0.26 1</diffuse></material>
        </visual>
        <visual name="tray_visual">
          <pose>0 0 0.110 0 0 0</pose>
          <geometry><box><size>0.025 0.025 0.010</size></box></geometry>
          <material><ambient>0.22 0.24 0.18 1</ambient><diffuse>0.36 0.38 0.26 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cuvette">
      <pose>0.2982 0.13235 0.1375 0 0 0</pose>
      <link name="body">
        <!-- 10 g is provisional; no received source gives a measured filled mass. -->
        <inertial>
          <mass>0.010</mass>
          <inertia>
            <ixx>0.0000018508</ixx><iyy>0.0000018508</iyy><izz>0.0000003267</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.014 0.014 0.045</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>0.88</mu><mu2>0.88</mu2></ode>
            </friction>
          </surface>
        </collision>
        <!--
          Approximate visual silhouette of the official WNDMC disposable COC
          microcuvette. Only the 14 mm grasp cross-section is project evidence;
          cap, chamber and foot dimensions below are illustrative.
        -->
        <visual name="clear_body_visual">
          <pose>0 0 0.004 0 0 0</pose>
          <geometry><box><size>0.014 0.014 0.030</size></box></geometry>
          <material>
            <ambient>0.82 0.92 0.95 0.35</ambient>
            <diffuse>0.82 0.92 0.95 0.35</diffuse>
          </material>
          <transparency>0.65</transparency>
        </visual>
        <visual name="cap_visual">
          <pose>0 0 0.0215 0 0 0</pose>
          <geometry><box><size>0.0155 0.0155 0.005</size></box></geometry>
          <material><ambient>0.05 0.28 0.75 1</ambient><diffuse>0.08 0.38 0.90 1</diffuse></material>
        </visual>
        <visual name="sample_chamber_visual">
          <pose>0 0 -0.004 0 0 0</pose>
          <geometry><box><size>0.006 0.006 0.018</size></box></geometry>
          <material><ambient>0.70 0.86 0.92 0.45</ambient><diffuse>0.70 0.86 0.92 0.45</diffuse></material>
          <transparency>0.55</transparency>
        </visual>
        <visual name="sample_visual">
          <pose>0 0 -0.007 0 0 0</pose>
          <geometry><box><size>0.005 0.005 0.010</size></box></geometry>
          <material><ambient>0.08 0.48 0.72 0.8</ambient><diffuse>0.08 0.48 0.72 0.8</diffuse></material>
          <transparency>0.2</transparency>
        </visual>
        <visual name="foot_front_left">
          <pose>0.0045 0.0045 -0.0175 0 0 0</pose>
          <geometry><box><size>0.0025 0.0025 0.010</size></box></geometry>
          <material><ambient>0.72 0.86 0.90 0.45</ambient><diffuse>0.72 0.86 0.90 0.45</diffuse></material>
          <transparency>0.55</transparency>
        </visual>
        <visual name="foot_front_right">
          <pose>0.0045 -0.0045 -0.0175 0 0 0</pose>
          <geometry><box><size>0.0025 0.0025 0.010</size></box></geometry>
          <material><ambient>0.72 0.86 0.90 0.45</ambient><diffuse>0.72 0.86 0.90 0.45</diffuse></material>
          <transparency>0.55</transparency>
        </visual>
        <visual name="foot_back_left">
          <pose>-0.0045 0.0045 -0.0175 0 0 0</pose>
          <geometry><box><size>0.0025 0.0025 0.010</size></box></geometry>
          <material><ambient>0.72 0.86 0.90 0.45</ambient><diffuse>0.72 0.86 0.90 0.45</diffuse></material>
          <transparency>0.55</transparency>
        </visual>
        <visual name="foot_back_right">
          <pose>-0.0045 -0.0045 -0.0175 0 0 0</pose>
          <geometry><box><size>0.0025 0.0025 0.010</size></box></geometry>
          <material><ambient>0.72 0.86 0.90 0.45</ambient><diffuse>0.72 0.86 0.90 0.45</diffuse></material>
          <transparency>0.55</transparency>
        </visual>
      </link>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>100</update_frequency>
      </plugin>
    </model>
  </world>
</sdf>
