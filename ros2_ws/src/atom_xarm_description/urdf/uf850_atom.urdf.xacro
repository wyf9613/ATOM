<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="ATOM_UF850">
  <xacro:arg name="ros2_control_plugin" default="uf_robot_hardware/UFRobotSystemHardware"/>
  <xacro:arg name="ros2_control_params" default=""/>
  <xacro:arg name="load_gazebo_plugin" default="false"/>
  <xacro:arg name="camera_enabled" default="false"/>
  <xacro:arg name="camera_nominal_extrinsics" default="false"/>
  <xacro:arg name="camera_mount_xyz" default="0 -0.075 0.140"/>
  <xacro:arg name="camera_mount_rpy" default="1.5707963267948966 -1.5707963267948966 0"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="gripper_mount_xyz" default="0 0 0"/>
  <!-- User-selected clocking: -90 degrees about the tool pointing (+Z) axis. -->
  <xacro:arg name="gripper_mount_rpy" default="0 0 -1.5707963267948966"/>

  <xacro:include filename="$(find xarm_description)/urdf/xarm_device_macro.xacro"/>
  <xacro:xarm_device
    prefix="$(arg prefix)"
    hw_ns="ufactory"
    limited="true"
    dof="6"
    robot_type="uf850"
    add_gripper="false"
    add_vacuum_gripper="false"
    add_bio_gripper="false"
    attach_to="world"
    attach_xyz="0 0 0"
    attach_rpy="0 0 0"
    create_attach_link="true"
    ros2_control_plugin="$(arg ros2_control_plugin)"
    ros2_control_params="$(arg ros2_control_params)"
    load_gazebo_plugin="$(arg load_gazebo_plugin)"/>

  <xacro:include filename="$(find atom_gripper_description)/urdf/atom_gripper_v2.urdf.xacro"/>
  <xacro:atom_gripper_v2 parent="$(arg prefix)link_eef" prefix="$(arg prefix)">
    <origin xyz="$(arg gripper_mount_xyz)" rpy="$(arg gripper_mount_rpy)"/>
  </xacro:atom_gripper_v2>
  <xacro:if value="$(arg camera_enabled)">
    <xacro:include filename="$(find atom_camera_description)/urdf/atom_d435i.urdf.xacro"/>
    <xacro:atom_d435i parent="$(arg prefix)tool_flange" nominal="$(arg camera_nominal_extrinsics)"
      xyz="$(arg camera_mount_xyz)" rpy="$(arg camera_mount_rpy)"/>
  </xacro:if>
</robot>
