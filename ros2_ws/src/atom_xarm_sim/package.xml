<?xml version="1.0"?>
<package format="3">
  <name>atom_xarm_sim</name>
  <version>0.1.0</version>
  <description>ATOM-owned headless simulation and smoke checks for the UFactory xArm 850.</description>
  <maintainer email="project-atom@unimelb.edu.au">Project ATOM</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>control_msgs</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>uf_ros_lib</exec_depend>
  <exec_depend>atom_xarm_dynamics</exec_depend>
  <exec_depend>xarm_controller</exec_depend>
  <exec_depend>xarm_description</exec_depend>
  <exec_depend>xarm_gazebo</exec_depend>
  <exec_depend>xarm_moveit_config</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
