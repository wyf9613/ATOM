# Proposed v1 contract between operator gateway and robot-local task executive.
# The executive owns planning, collision checks, stop inhibition and task cancellation.
uint8 OBSERVE=0
uint8 PICK=1
uint8 PLACE=2
uint8 NAVIGATE=3
string request_id
uint8 operation
uint8 slot_id
geometry_msgs/PoseStamped target
---
bool success
string error_code
string message
---
string state
float32 progress
string message
